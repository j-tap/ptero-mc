APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_THEME=pterodactyl
APP_TIMEZONE=UTC
APP_URL=http://panel.example.com
APP_LOCALE=en
APP_ENVIRONMENT_ONLY=true

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=panel
DB_USERNAME=pterodactyl
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_DRIVER=file
QUEUE_CONNECTION=redis
SESSION_DRIVER=file

HASHIDS_SALT=
HASHIDS_LENGTH=8

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Pterodactyl Panel"
# You should set this to your domain to prevent it defaulting to 'localhost', causing
# mail servers such as Gmail to reject your mail.
#
# @see: https://github.com/pterodactyl/panel/pull/3110
# MAIL_EHLO_DOMAIN=panel.example.com

MINECRAFT_AVATAR_URL=https://your-skin-service/helm/{uuid}/256.png
# 3D viewer + skinTexture API: __mojang__ (default) or direct PNG URL template ({uuid} = no dashes).
# Example: MINECRAFT_SKIN_URL=https://velithcraft.online/skin/{uuid}
MINECRAFT_SKIN_URL=https://your-skin-service/skin/{uuid}
# When Mojang/skin_url returns nothing (e.g. offline UUID), viewer uses this PNG URL. Empty = no fallback.
# MINECRAFT_SKIN_PREVIEW_FALLBACK_URL=https://velithcraft.online/skin/{uuid}
MINECRAFT_AUTHME_TABLE=authme
# Optional: player license flags (overrides UUID heuristic when a row exists for the name)
# MINECRAFT_LICENSE_TABLE=player_licenses
# MINECRAFT_LICENSE_USERNAME_COLUMN=username
# MINECRAFT_LICENSE_COLUMN=licensed

# Optional: one URL template for custom/mod item icons (merged with built-in vanilla mcasset URLs in code).
# Placeholders: {path} (id without minecraft:), {path_uri} (URL-encoded).
# MINECRAFT_ITEM_ICON_CUSTOM_URL=https://example.com/api/minecraft/items/{path}/image

# Optional: opens in a new tab from the player management page (http or https only).
# MINECRAFT_EXTERNAL_STATS_URL=https://stats.site.com/
